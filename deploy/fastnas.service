[Unit]
Description=FastNAS private cloud storage
Documentation=https://github.com/fastnas/fastnas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fastnas
WorkingDirectory=/var/lib/fastnas
Restart=on-failure
RestartSec=5

# Configuration. Prefer an EnvironmentFile so the auth key isn't world-readable
# in the unit: create /etc/fastnas.env with TS_AUTH_KEY=tskey-auth-... (chmod 600).
EnvironmentFile=-/etc/fastnas.env
Environment=DATA_DIR=/var/lib/fastnas/data

# Run as an isolated, unprivileged dynamic user. tsnet uses userspace
# networking, so no host port (and no CAP_NET_BIND_SERVICE) is required.
DynamicUser=yes
StateDirectory=fastnas
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
